# Copy to .env and edit:   cp .env.example .env
NODE_ENV=production
PORT=3000

# Public address people use to reach Iris. Used inside emailed links.
# Examples: http://203.0.113.10:3000  (first test)   https://iris.exquisappfactory.com  (later, with HTTPS)
APP_BASE_URL=http://localhost:3000

# REQUIRED. Random secret that signs login cookies. Generate: openssl rand -hex 32
JWT_SECRET=change-me

# Only emails ending with this domain can sign up.
ALLOWED_EMAIL_DOMAIN=exquisappfactory.com

# Comma-separated emails that become ADMIN when they register. Register with one of these first.
ADMIN_EMAILS=you@exquisappfactory.com

# Email. For real email, fill SMTP_* and delete the MAIL_MODE line.
# For first tests without email, keep MAIL_MODE=console: links are printed in `docker compose logs iris`.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Iris <no-reply@exquisappfactory.com>

# Set to true ONLY when Iris is served over HTTPS (Stage 6). With plain http, login would break.
COOKIE_SECURE=false

# Set to 1 only when running behind Caddy/Nginx (Stage 6).
TRUST_PROXY=0

# Where data lives on the SERVER (host folder). In production: the mounted data disk.
# Leave blank to use ./data next to docker-compose.yml (run: mkdir -p data && sudo chown 1000:1000 data)
DATA_DIR=/mnt/iris-data

# Storage paths INSIDE the container. Do not change.
DB_PATH=/app/data/iris.db
UPLOAD_DIR=/app/data/uploads

# ---- Backups (STEPS.md steps 1-3) ----
# Turn the backup helpers on: continuous database copy to S3 + hourly pictures copy.
# Leave empty to run without backups (testing only).
COMPOSE_PROFILES=backup
LITESTREAM_BUCKET=your-bucket-name
LITESTREAM_REGION=eu-west-1
